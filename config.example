# PeekAStokk example configuration.
#
# Copy to one of (searched in this order, first match wins):
#   $XDG_CONFIG_HOME/peekastokk/config   (~/.config/peekastokk/config)
#   ~/.peekastokk
#   ~/.peekastokk/config
#   /etc/peekastokk/config               (system-wide fallback, checked last)
# or point at it explicitly with:  peekastokk -config /path/to/config
#
# Every key is optional; command-line flags override anything set here.
# Lines starting with # or ; are comments, as is an unquoted trailing
# "  # comment". Quote a value to keep a literal # or surrounding spaces.

# Port to listen on (keeps the default host, 127.0.0.1).
port = 8844

# ...or set the full listen address instead of "port" (never both).
# Anything other than 127.0.0.1 exposes your logs to the network — read the
# "Security note" in the README first.
#addr = 0.0.0.0:8844

# Recent lines replayed to newly connected browsers.
history = 2000

# Default number of lines the web UI keeps on screen.
# Adjustable live in the UI; a value chosen there sticks (per browser).
lines = 500

# How often tailed files are checked for new data.
poll = 200ms

# How often directory and glob arguments are re-scanned, picking up log
# files created or deleted later. 0 disables: expand once at startup.
#rescan = 60s

# Max bytes of existing content replayed per file at startup.
# Negative starts at the end of the file (no replay).
tail-bytes = 65536

# Lines longer than this are split into chunks.
max-line-bytes = 262144

# debug, info, warn, or error.
log-level = info

# Require a username and password to view the logs (HTTP basic auth).
# Off by default — uncomment "auth" below to enable; -auth "" on the
# command line overrides this back to open access.
#
# Generate the hashed password like this (prompts twice, input hidden):
#
#   $ peekastokk -hash-password
#   Password:
#   Repeat password:
#   $argon2id$v=19$m=65536,t=3,p=4$mvaJfpeyc7nZ7uf3e4Vb2g$0Fyiy...
#
# then paste it after "<username>:" — no quotes needed:
#
#   auth = dev:$argon2id$v=19$m=65536,t=3,p=4$mvaJfpeyc7nZ7uf3e4Vb2g$0Fyiy...
#
# (Scripts can pipe instead: echo 'pw' | peekastokk -hash-password)
#
# A plaintext password also works (auth = dev:changeme) but logs a startup
# warning. Basic auth is sent as-is over plain HTTP: put a TLS proxy in
# front when exposing beyond localhost.
#auth = dev:$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0c2FsdA$...

# Log files to tail: repeat "file" once per entry. A leading ~ expands to
# your home directory; relative paths resolve against this file's
# directory. Plain files that do not exist yet are waited for.
# Directories mean every file directly inside them, and glob patterns
# (*.log, myproject*, ...) expand at startup.
#
# An optional ":alias" suffix renames the source in the file picker (and
# in what a forwarding client sends): on a plain file the alias is the
# name, on a directory or glob it prefixes each file's own name, so
# same-named logs from different places stay apart.
file = /var/log/system.log
file = ~/logs/app.log
#file = /srv/app/current/log/production.log:app     ; shown as "app"
#file = ~/logs/myapp/:worker1                       ; "worker1/<file>"
#file = /var/log/nginx/*.log:edge                   ; "edge/access.log", ...
#file = ~/logs/myapp/
#file = /var/log/nginx/*.log
#file = "/var/log/name with spaces.log"

# ---------------------------------------------------------------------------
# Forwarding (see the "Forwarding" section of the README).
#
# SERVER side: accept lines from forwarding clients. One line per client;
# generate the token + hash with:  peekastokk -generate-token
#ingest = homelab-1:$argon2id$v=19$m=65536,t=3,p=4$...

# CLIENT side: run headless and push everything tailed here to a central
# PeekAStokk server.
#headless      = true
#forward-to    = http://central:8844
#forward-token = <plaintext token from -generate-token>
#forward-buffer-lines = 5000
#status-addr   = 127.0.0.1:8845   ; optional monitoring: /healthz, /statusz

# Docker container logs (read-only file access, no Docker socket).
# If data-root was moved: docker info --format '{{.DockerRootDir}}' + "/containers"
#docker      = true
#docker-root = /var/lib/docker/containers
#docker-poll = 2s
# Repeat docker-containers per selection: exact "name[:alias]" (alias sets
# the display name), a glob like 'web-*', or * for all (the default).
#docker-containers = nginx-prod:web
#docker-containers = api-*
